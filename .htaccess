Options -Indexes
AddDefaultCharset utf-8

# Never expose dotfiles (server config, CI metadata, deploy state, tool config).
<FilesMatch "^\.">
	Require all denied
</FilesMatch>

# Keep tooling files out of the published site.
<FilesMatch "^(package\.json|package-lock\.json|commitlint\.config\.ts)$">
	Require all denied
</FilesMatch>


Header unset Content-Security-Policy
Header add Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests;"
Header unset X-Content-Security-Policy
Header add X-Content-Security-Policy "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests;"
Header unset X-WebKit-CSP
Header add X-WebKit-CSP "default-src 'none'; script-src 'none'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests;"


Header unset X-Content-Type-Options
Header add X-Content-Type-Options "nosniff"

Header unset Strict-Transport-Security
Header add Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"

Header unset X-Frame-Options
Header add X-Frame-Options "DENY"

Header unset Referrer-Policy
Header add Referrer-Policy "no-referrer"

Header unset X-XSS-Protection
Header add X-XSS-Protection "0"

Header unset Origin-Agent-Cluster
Header add Origin-Agent-Cluster "?1"

Header unset X-DNS-Prefetch-Control
Header add X-DNS-Prefetch-Control "off"

Header unset Cross-Origin-Opener-Policy
Header add Cross-Origin-Opener-Policy "same-origin"

Header unset Cross-Origin-Embedder-Policy
Header add Cross-Origin-Embedder-Policy "require-corp"

Header unset Cross-Origin-Resource-Policy
Header add Cross-Origin-Resource-Policy "same-origin"

Header unset Permissions-Policy
Header add Permissions-Policy "accelerometer=(), attribution-reporting=(), autoplay=(), browsing-topics=(), camera=(), clipboard-read=(), clipboard-write=(), compute-pressure=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), hid=(), join-ad-interest-group=(), local-fonts=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), private-aggregation=(), publickey-credentials-get=(), run-ad-auction=(), screen-wake-lock=(), serial=(), shared-storage=(), storage-access=(), usb=(), window-management=(), xr-spatial-tracking=()"

Header unset X-Permitted-Cross-Domain-Policies
Header add X-Permitted-Cross-Domain-Policies "none"


Redirect 301 /.well-known/caldav https://calendar.zoho.eu/.well-known/caldav
Redirect 301 /.well-known/carddav https://contacts.zoho.eu/.well-known/carddav


# WebFinger alias: @johannes@holzhaeuer.net -> @holzhaeuer@mastodon.social
<Files "webfinger">
	ForceType application/jrd+json
	Header set Access-Control-Allow-Origin "*"
	Header set Cross-Origin-Resource-Policy "cross-origin"
</Files>

<Files "security.txt">
	ForceType text/plain
</Files>
